<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="AXIOMIX admin dashboard">
    <base href="~/admin/">
    <title>Dashboard | AXIOMIX</title>

    <link rel="stylesheet" href="css/bootstrap.min.css">
    <link rel="stylesheet" href="vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/admin-theme.css"
          asp-append-version="true">
</head>

<body>
    <div class="admin-shell">
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <aside class="admin-sidebar" id="adminSidebar"
               aria-label="Əsas menyu">

            <div class="sidebar-header">
                <a class="brand-mark" href="/Admin/Index">
                    <span class="brand-icon">
                        <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
                    </span>

                    <span class="brand-copy">
                        <span class="brand-title">AXIOMIX</span>
                        <span class="brand-subtitle">İdarəetmə paneli</span>
                    </span>
                </a>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link active" asp-controller="Dashboard" asp-action="Index" aria-current="page">
                    <span class="nav-icon">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">Dashboard</span>
                </a>

                <a class="nav-link" asp-controller="Users"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-people" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">İstifadəçilər</span>
                </a>

                <a class="nav-link" asp-controller="Users"
                   asp-action="Add">
                    <span class="nav-icon">
                        <i class="bi bi-person-plus" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">İstifadəçi əlavə et</span>
                </a>

                <a class="nav-link" asp-controller="Profiles"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-person-badge" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">Profil</span>
                </a>

                <a class="nav-link" asp-controller="Chart"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">Qrafiklər</span>
                </a>

                <a class="nav-link" asp-controller="Table"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-table" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">Cədvəllər</span>
                </a>
                <a class="nav-link" asp-controller="Settings"
                   asp-action="Index">
                    <span class="nav-icon">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                    </span>
                    <span class="nav-text">Parametrlər</span>
                </a>            
            </nav>

            <div class="sidebar-footer">
                <span class="status-dot"></span>
                <span class="sidebar-footer-text">Sistem aktivdir</span>
            </div>
        </aside>

        <div class="admin-main">
            <nav class="navbar admin-navbar navbar-expand bg-white">
                <div class="container-fluid px-3 px-lg-4">
                    <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar" aria-expanded="true" aria-label="Toggle sidebar">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    <form class="d-none d-md-flex ms-3 flex-grow-1" role="search">
                        <input class="form-control search-input" type="search" placeholder="Search users, orders, reports" aria-label="Search">
                    </form>

                    <div class="navbar-actions ms-auto">
               
                        <div class="dropdown">
                        
                            <div class="dropdown-menu dropdown-menu-end notification-menu">
                                <div class="dropdown-header fw-bold text-body">Notifications</div>
                                <a class="dropdown-item" href="users.html">
                                    <span class="notification-title">New user registered</span>
                                    <span class="notification-time">4 minutes ago</span>
                                </a>
                                <a class="dropdown-item" href="charts.html">
                                    <span class="notification-title">Revenue target reached</span>
                                    <span class="notification-time">32 minutes ago</span>
                                </a>
                                <a class="dropdown-item" href="settings.html">
                                    <span class="notification-title">Security review completed</span>
                                    <span class="notification-time">1 hour ago</span>
                                </a>
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span>Denikayeva Aynur</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <!-- Başlanğıca / işarəsi qoyaraq base href teqini bypass edirik -->
                                <li><a class="dropdown-item" href="/Admin/Profiles/Index">Profil</a></li>
                                <li><a class="dropdown-item" href="/Admin/Settings/Index">Parametrlər</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <!-- Birbaşa çıxış metodunun tam ünvanı -->
                                <li><a class="dropdown-item" href="/Home/Index">Çıxış</a></li>
                            </ul>
                        </div>


                    </div>
                </div>
            </nav>
            @RenderBody()
        </div>
    </div>

    <script src="js/bootstrap.bundle.min.js"></script>
    <script src="js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
