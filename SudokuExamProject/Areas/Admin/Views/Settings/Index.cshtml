@model SudokuExamProject.Models.SiteSettings

@{
    ViewData["Title"] = "Parametrlər";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-3 px-lg-4 py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Parametrlər</h3>
            <p class="text-muted mb-0">
                AXIOMIX platformasının təhlükəsizlik parametrlərini idarə et.
            </p>
        </div>

        <i class="fa fa-cog fa-2x text-secondary"></i>
    </div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"></div>

    <form asp-area="Admin"
          asp-controller="Settings"
          asp-action="Index"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <!-- İstifadəçi və təhlükəsizlik -->
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="fa fa-shield me-2"></i>
                    İstifadəçi və təhlükəsizlik
                </h5>
            </div>

            <div class="card-body"

                <!-- Minimum şifrə uzunluğu -->
                <div class="mb-4">
                    <label asp-for="MinimumPasswordLength"
                           class="form-label">
                        Minimum şifrə uzunluğu
                    </label>

                    <input asp-for="MinimumPasswordLength"
                           class="form-control"
                           type="number"
                           min="6"
                           max="32" />

                    <span asp-validation-for="MinimumPasswordLength"
                          class="text-danger">
                    </span>
                </div>

                <!-- Uğursuz giriş cəhdləri -->
                <div>
                    <label asp-for="MaxFailedLoginAttempts"
                           class="form-label">
                        Maksimum uğursuz giriş cəhdi
                    </label>

                    <input asp-for="MaxFailedLoginAttempts"
                           class="form-control"
                           type="number"
                           min="1"
                           max="10" />

                    <span asp-validation-for="MaxFailedLoginAttempts"
                          class="text-danger">
                    </span>
                </div>

            </div>
        </div>

        <!-- Düymələr -->
        <div class="d-flex justify-content-end gap-2">

            <button type="submit"
                    class="btn btn-light"
                    formaction="@Url.Action("Reset", "Settings", new { area = "Admin" })"
                    formmethod="post">

                <i class="fa fa-refresh me-2"></i>
                Sıfırla
            </button>

            <button type="submit" class="btn btn-primary px-4">
                <i class="fa fa-save me-2"></i>
                Yadda saxla
            </button>

        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
