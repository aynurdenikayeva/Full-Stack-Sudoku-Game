@model List<SudokuExamProject.Models.User>

@{
    ViewData["Title"] = "İstifadəçilər";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Başlıq və yeni istifadəçi düyməsi -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">İstifadəçilər</h2>
            <p class="text-muted mb-0">
                Sudoku oyununun istifadəçilərini idarə et.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Add"
           class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>
            Yeni istifadəçi
        </a>
    </div>

    <!-- İstifadəçilər cədvəli -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Ad, soyad</th>
                            <th>İstifadəçi adı</th>     
                            <th>Rol</th>
                            <th>Sudoku səviyyəsi</th>
                            <th>Status</th>
                            <th class="text-center">Əməliyyatlar</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Id</td>

                                    <td class="fw-semibold">
                                        @user.Name @user.Surname
                                    </td>

                                    <td>@user.UserName</td>


                                  

                                    <td>
                                        <span class="badge bg-primary">
                                            @user.UserRole
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(user.SudokuLevel)
                                                                        ? "—"
                                                                        : user.SudokuLevel)
                            </td>

                                    <td>
                                        <form method="post" asp-action="IsActiveStatus">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-link  text-decoration-none p-0 m-0 align-baseline">
                                        @if (user.AccountStatus == "Active")
                                                {
                                                    <span class="badge bg-success">Aktiv</span>
                                                }
                                                else if (user.AccountStatus == "Blocked")
                                                {
                                                    <span class="badge bg-danger">Bloklanıb</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Aktiv deyil</span>
                                                }
                                            </button>
                                        </form>
                                    </td>


                                    <td>
                                        <div class="d-flex justify-content-between gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Users"
                                               asp-action="Update"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-primary text-nowrap">
                                                <i class="bi bi-pencil-square"></i>
                                                Redaktə
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="Users"
                                               asp-action="Read"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-success text-nowrap">
                                                <i class="bi bi-eye"></i>
                                                Ətraflı
                                            </a>

                                            <form asp-area="Admin"
                                                  asp-controller="Users"
                                                  asp-action="Delete"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Bu istifadəçini silmək istədiyinizə əminsiniz?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger text-nowrap">
                                                    <i class="bi bi-trash"></i>
                                                    Sil
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-5">
                                    <i class="bi bi-people fs-2 d-block mb-2"></i>
                                    Hələ istifadəçi əlavə edilməyib.

                                    <div class="mt-3">
                                        <a asp-area="Admin"
                                           asp-controller="Users"
                                           asp-action="Add"
                                           class="btn btn-sm btn-primary">
                                            İlk istifadəçini əlavə et
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
