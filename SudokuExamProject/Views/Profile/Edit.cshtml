@model SudokuExamProject.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Profili redaktə et";
}

<main class="profile-edit-page">
    <div class="container profile-edit-container">

        <!-- Başlıq -->
        <div class="profile-edit-title">
            <div class="profile-edit-icon">
                <i class="bi bi-person-gear"></i>
            </div>

            <div>
                <h1>Profili redaktə et</h1>
                <p>Şəxsi məlumatlarını yenilə və yadda saxla.</p>
            </div>
        </div>

        <!-- PROFİL MƏLUMATLARININ FORMU -->
        <form asp-controller="Profile"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger profile-validation-summary"
                 role="alert"></div>

            <div class="profile-edit-card">

                <!-- Profil şəkli -->
                <div class="profile-edit-header text-center">

                    <div class="profile-photo-wrapper">

                        <img id="profilePreview"
                             src="@(string.IsNullOrWhiteSpace(Model.CurrentImage)
                                                             ? Url.Content("~/images/default-avatar.png")
                                                             : Model.CurrentImage)"
                             alt="Profil şəkli"
                             class="profile-photo" />

                        <label for="ProfileImage"
                               class="photo-upload-label"
                               title="Profil şəkli seç">
                            <i class="bi bi-camera-fill"></i>
                        </label>

                        <input asp-for="ProfileImage"
                               type="file"
                               id="ProfileImage"
                               accept=".jpg,.jpeg,.png,.webp"
                               class="d-none" />
                    </div>

                    <h2>Profil şəklin</h2>
                    <p>JPG, PNG və ya WEBP · Maksimum 2 MB</p>

                    <span asp-validation-for="ProfileImage"
                          class="text-danger validation-message d-block"></span>
                </div>

                <!-- Şəxsi məlumatlar -->
                <div class="profile-form-section">

                    <div class="profile-form-heading">
                        <h3>Şəxsi məlumatlar</h3>
                        <p>Hesabında istifadə olunan məlumatları burada dəyişə bilərsən.</p>
                    </div>

                    <div class="row g-3">

                        <!-- Ad -->
                        <div class="col-md-6">
                            <label asp-for="Name" class="profile-form-label">
                                Ad
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person profile-input-icon"></i>
                                </span>

                                <input asp-for="Name"
                                       class="form-control profile-input"
                                       placeholder="Adınızı daxil edin" />
                            </div>

                            <span asp-validation-for="Name"
                                  class="text-danger validation-message"></span>
                        </div>

                        <!-- Soyad -->
                        <div class="col-md-6">
                            <label asp-for="Surname" class="profile-form-label">
                                Soyad
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-person-vcard profile-input-icon"></i>
                                </span>

                                <input asp-for="Surname"
                                       class="form-control profile-input"
                                       placeholder="Soyadınızı daxil edin" />
                            </div>

                            <span asp-validation-for="Surname"
                                  class="text-danger validation-message"></span>
                        </div>

                        <!-- İstifadəçi adı -->
                        <div class="col-12">
                            <label asp-for="Username" class="profile-form-label">
                                İstifadəçi adı
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-at profile-input-icon"></i>
                                </span>

                                <input asp-for="Username"
                                       class="form-control profile-input"
                                       placeholder="İstifadəçi adınızı daxil edin" />
                            </div>

                            <span asp-validation-for="Username"
                                  class="text-danger validation-message"></span>
                        </div>

                        <!-- Telefon -->
                        <div class="col-12">
                            <label asp-for="PhoneNumber" class="profile-form-label">
                                Telefon nömrəsi
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-telephone profile-input-icon"></i>
                                </span>

                                <input asp-for="PhoneNumber"
                                       class="form-control profile-input"
                                       placeholder="+994 XX XXX XX XX" />
                            </div>

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger validation-message"></span>
                        </div>

                    </div>

                    <!-- Məlumat -->
                    <div class="profile-info-box">
                        <i class="bi bi-info-circle"></i>
                        <span>
                            Email, hesab statusu və Sudoku səviyyəsi
                            təhlükəsizlik məqsədilə bu səhifədən dəyişdirilmir.
                        </span>
                    </div>

                    <!-- Düymələr -->
                    <div class="profile-actions">

                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="profile-cancel-btn">
                            <i class="bi bi-arrow-left"></i>
                            Ləğv et
                        </a>

                        <button type="submit" class="profile-save-btn">
                            <i class="bi bi-check2-circle"></i>
                            Yadda saxla
                        </button>

                    </div>

                </div>
            </div>
        </form>

        <!-- PAROLUN DƏYİŞDİRİLMƏSİ -->
        <section class="password-change-card mt-4">

            <div class="password-change-header">
                <div class="password-change-icon">
                    <i class="fa fa-lock"></i>
                </div>

                <div>
                    <h4>Parolun dəyişdirilməsi</h4>
                    <p>Hesabınızın təhlükəsizliyi üçün parolunuzu yeniləyin.</p>
                </div>
            </div>

            <!-- Uğurlu əməliyyat mesajı -->
            @if (TempData["PasswordSuccess"] != null)
            {
                <div class="alert alert-success">
                    <i class="fa fa-check-circle me-2"></i>
                    @TempData["PasswordSuccess"]
                </div>
            }

            <!-- Xəta mesajı -->
            @if (TempData["PasswordError"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fa fa-exclamation-circle me-2"></i>
                    @TempData["PasswordError"]
                </div>
            }

            <!-- Parol dəyişdirmə formu -->
            <form asp-controller="Profile"
                  asp-action="ChangePassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="password-form-group">
                    <label for="CurrentPassword">Mövcud parol</label>

                    <input type="password"
                           id="CurrentPassword"
                           name="CurrentPassword"
                           class="form-control"
                           placeholder="Mövcud parolunuzu daxil edin"
                           autocomplete="current-password"
                           required />
                </div>

                <div class="password-form-group">
                    <label for="NewPassword">Yeni parol</label>

                    <input type="password"
                           id="NewPassword"
                           name="NewPassword"
                           class="form-control"
                           placeholder="Yeni parol daxil edin"
                           autocomplete="new-password"
                           required />
                </div>

                <div class="password-form-group">
                    <label for="ConfirmNewPassword">Yeni parolun təkrarı</label>

                    <input type="password"
                           id="ConfirmNewPassword"
                           name="ConfirmNewPassword"
                           class="form-control"
                           placeholder="Yeni parolu təkrar daxil edin"
                           autocomplete="new-password"
                           required />
                </div>

                <!-- Yadda saxla -->
                <div class="profile-actions">
                    <button type="submit" class="profile-save-btn">
                        <i class="bi bi-check2-circle"></i>
                        Yadda saxla
                    </button>
                </div>

            </form>
        </section>

    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("ProfileImage").addEventListener("change", function (event) {
            const file = event.target.files[0];

            if (!file) return;

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {
                alert("Yalnız JPG, PNG və WEBP formatlı şəkil seçə bilərsiniz.");
                event.target.value = "";
                return;
            }

            if (file.size > 2 * 1024 * 1024) {
                alert("Şəklin ölçüsü maksimum 2 MB olmalıdır.");
                event.target.value = "";
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                document.getElementById("profilePreview").src = e.target.result;
            };

            reader.readAsDataURL(file);
        });
    </script>
}
