@model SudokuExamProject.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Daxil ol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
</head>
<body>

    <main class="login-split-container">

        <div class="outer-back-link-wrapper">
            <a href="javascript:void(0);" onclick="history.back();" class="outer-back-link">
                ← Əvvəlki səhifəyə qayıt
            </a>
        </div>

        <div class="login-main-card">

            <section class="login-form-side">
                <div class="brand-header">
                    <h1>Hesab yarat</h1>
                    <p>AXIOMIX ailəsinə qoşul!</p>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }


                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-1"></div>

            

                    <div class="form-group-block">
                        <label asp-for="Email" class="form-label">E-poçt</label>
                        <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group-block">
                        <label asp-for="Password" class="form-label">Şifrə</label>
                        <input asp-for="Password" class="form-control" placeholder="Ən azı 8 simvol" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>


                    <button type="submit" class="register-button">Daxil ol</button>
                </form>

                <div class="social-divider">və ya</div>
                <div class="social-group">
                    <a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google" class="btn-social btn-google">
                        <span class="icon-google-local"></span> Google ilə davam et
                    </a>

                    <a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="GitHub" class="btn-social btn-github">
                        <span class="icon-github-local"></span> GitHub ilə davam et
                    </a>
                </div>

           
            </section>

            <!-- SAĞ HİSSƏ: ŞƏKİL SAHƏSİ -->
            <section class="login-image-side">
                <img src="~/images/sudoku-register.jpg" alt="Qeydiyyat İllüstrasiyası" class="custom-register-img" />
            </section>

        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

</body>
</html>
